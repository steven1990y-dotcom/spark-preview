    "version": "1.2.0",
    "fontFamily": "-apple-system, \"SF Pro Text\", \"SF Pro Display\", system-ui, sans-serif",
    "displayFontFamily": "ui-rounded, \"SF Pro Display\", -apple-system, system-ui, sans-serif",
    "surface-card": "alias: surface",
    "accentUsage": "仅插画和数据可视化，不承载文字",
    "aiRule": "先出草稿 → 用户确认 → 再入库",
    "i18n": {
      "supported": [
        "en",
        "zh-Hans"
      ],
      "preferenceValues": [
        "system",
        "en",
        "zh"
      ],
      "defaultRule": "Preference defaults to system. Resolve: if system language starts with zh use Chinese, else English. Persist preference to localStorage nori_lang as system|en|zh.",
