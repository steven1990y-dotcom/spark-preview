      "tabLabels": {
        "en": "Home / Bills / + / Reports / Insights",
        "zh": "首页 / 账单 / + / 报表 / 洞察"
      },
      "noLifetime": true,
      "noThirdLanguage": true
    },
    "uiDefaultLanguage": "navigator.language → zh* = 中文, else English; remember via localStorage.nori_lang",
    "noriVersion": "4-squircle",
    "productLock": "MVP-LOCKED-v1.md",
    "pricing": {
      "monthly": 4.99,
      "yearly": 39.99,
      "earlyBirdFirstYear": 29.99,
      "freeCloudAI": 20,
      "plusCloudAI": 300,
      "topUp": {
        "uses": 100,
        "price": 0.99
      },
      "familyMax": 5,
      "lifetime": false
    },
    "changelog": "v1.2: 18 component patches, default Home A"
  },
