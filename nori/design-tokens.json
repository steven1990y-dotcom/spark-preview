    "sheet": "0 16px 48px rgba(43,36,32,0.08)",
    "dark": "none"
  },
  "touchTarget": 44,
  "nori": {
    "version": "4",
    "shape": "squircle",
    "style": "grok-bot-family-flat",
    "defaultBody": "#F3E3C3",
    "defaultBodyName": "Cream Warm",
    "defaultBodyRationale": "在画布 #FAF6EE 与白色卡片上对比清晰可读；官方 Cream Light #F1EFE9 过浅易融进背景；Cream Gold #E7B65C 过跳，仅作强调而非默认身体色。",
    "eye": "#111111",
    "ring": "#C4A574",
    "notification": "#3b93f0",
    "noDecorations": [
      "blush",
      "highlight",
      "stroke",
      "mouth",
      "gradient-body"
    ],
    "assetsDir": "../nori-v4/final/",
    "assets": {
      "master": "../nori-v4/final/nori-squircle.svg",
      "idle": "../nori-v4/final/nori-squircle-idle.svg",
      "thinking": "../nori-v4/final/nori-squircle-thinking.svg",
      "orbit": "../nori-v4/final/nori-squircle-orbit.svg",
      "notification": "../nori-v4/final/nori-squircle-notification.svg",
      "waiting": "../nori-v4/final/nori-squircle-waiting.svg",
      "swirl": "../nori-v4/final/nori-squircle-swirl.svg",
      "done": "../nori-v4/final/nori-squircle-done.svg"
    },
    "sceneMap": {
      "onboarding": "idle",
      "home.greeting": "idle",
      "home.empty": "idle",
      "settings.companion": "idle",
      "review.ocr": "thinking",
      "add.receipt": "thinking",
      "add.sentence.drafting": "thinking",
      "review.awaitConfirm": "waiting",
      "permission.denied": "waiting",
      "insights.nudge": "orbit",
      "insights.intro": "idle",
      "paywall.quota": "notification",
      "quota.exhausted": "notification",
      "review.saved": "done",
      "decorativeWorking": "swirl"
    },
    "animations": {
      "idle": {
        "breathe": "3.2s ease-in-out infinite ±1.5%",
        "blink": "3.8s / ~160ms",
        "yaw": "6s ±1.2deg"
      },
      "thinking": {
        "dots": "1.2s ease-in-out",
        "phase": "0.18s",
        "body": "hidden"
      },
      "orbit": {
        "rings": "3s linear",
        "bodyScale": 0.86,
        "eyeTrack": "3s"
      },
      "notification": {
        "badgePulse": "2s ±12%",
        "color": "#3b93f0"
      },
      "waiting": {
        "eyes": "flat",
        "breathe": "4s"
      },
      "swirl": {
        "rings": "2.4s / 2.8s reverse / 3.2s"
      },
      "done": {
        "pop": "0.7s",
        "burst": "1.8s x2"
      },
      "prefersReducedMotion": "freeze all; keep static expression"
    },
    "cssVariables": {
      "--nori-body": "#F3E3C3",
      "--nori-eye": "#111111",
      "--nori-ring": "#C4A574",
      "--nori-notif": "#3b93f0"
    },
    "darkAdaptation": {
      "body": "#F3E3C3",
      "eye": "#111111",
      "ring": "#C4A574",
      "note": "Body/eyes unchanged in dark; rings remain readable on canvas #1C1916"
    },
    "emotionsV5": {
      "source": "../nori-v5/ (read-only)",
      "files": [
        "emotion-happy",
        "emotion-surprise",
        "emotion-shy",
        "emotion-worry",
        "emotion-proud",
        "emotion-sleepy",
        "emotion-annoyed",
        "emotion-curious"
      ],
      "previewHelper": "noriEmotion(name,size)",
      "sceneMap": {
        "onboarding": "shy",
        "home.greeting": "happy",
        "home.empty": "shy",
        "settings.companion": "happy",
        "insights": "curious",
        "quota.exhausted": "worry",
        "permission.denied": "annoyed",
        "streak.success": "happy",
        "big.income": "surprise",
        "over.budget": "worry",
        "late.night": "sleepy",
        "ocr.fail": "annoyed",
        "savings.goal": "proud"
      }
    }
  },
  "componentsV12": {
    "upcoming": {
      "layout": "horizontal scroll snap",
      "windowDays": 7,
      "cardWidth": 158,
      "radius": 24
    },
    "bulkConfirm": {
      "requiresSecondConfirmation": true,
      "sheetRadius": 32
    },
    "toast": {
      "durationMs": 5000,
      "undo": true,
      "radius": 16
    },
    "categoryRule": {
      "storage": "local",
      "cloudCost": 0,
      "choices": [
        "yes",
        "only-once"
      ]
    },
    "duplicate": {
      "choices": [
        "merge",
        "save-anyway",
        "view"
      ],
      "cloudCost": 0
    },
    "refund": {
      "type": "Refund",
      "amount": "positive",
      "report": "deduct from category net spending"
    },
    "quickActions": {
      "collapseOnScroll": true,
      "expandAfterIdleMs": 700
    },
    "home": {
      "defaultScheme": "A",
      "idealPace": "only with total monthly budget"
    },
    "states": [
      "first-use",
      "no-budget",
      "no-spend-today",
      "filter-no-results",
      "offline",
      "error"
    ],
    "widgets": [
      "small-today",
      "medium-today-month-sentence-deep-link",
      "lock-add"
    ],
    "touchTarget": 44
  }
}
